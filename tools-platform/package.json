{
  "name": "tools-platform",
  "version": "1.0.195",
  "description": "Tools Platform Desktop App",
  "repository": "github:fanxiaolongx-max/privacy-policy",
  "main": "electron-main.js",
  "scripts": {
    "start": "node backend/server.js",
    "start:desktop": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "license:sync-desktop-key": "node scripts/sync-desktop-license-public-key.js",
    "license:verify-desktop-config": "node scripts/verify-desktop-license-client-config.js",
    "defaults:export": "node scripts/export-default-quick-start-bundle.js && node scripts/update-default-quick-start-readme.js",
    "splash:generate": "electron scripts/generate-portable-splash.js",
    "build:win": "npm run license:verify-desktop-config && npm run release:verify-assets && npm run build:win:setup && npm run build:win:portable",
    "build:win:setup": "electron-builder --win nsis --x64 -p never",
    "build:win:portable": "electron-builder --win portable --x64 -p never --config.win.icon=frontend/assets/icon-windows-portable.ico",
    "build:win:publish": "npm run license:verify-desktop-config && electron-builder --win nsis --x64 --publish always && electron-builder --win portable --x64 --publish always --config.win.icon=frontend/assets/icon-windows-portable.ico",
    "build:mac": "npm run license:verify-desktop-config && electron-builder --mac -p never",
    "release:verify-assets": "node scripts/verify-release-assets.js"
  },
  "build": {
    "appId": "com.toolsplatform.app",
    "productName": "Tools Platform",
    "directories": {
      "output": "dist"
    },
    "files": [
      "backend/**/*",
      "frontend/**/*",
      "scripts/generate-custom-tool-i18n.js",
      "electron-main.js",
      "electron-preload.js",
      "desktop-license-client.js",
      "desktop-license-preload.js",
      "README.md",
      "!backend/models/desktop-license-authority.js",
      "!backend/models/desktop-license-registry.js",
      "!backend/routes/desktop-license-admin.js",
      "!backend/routes/desktop-license-public.js",
      "!backend/data/desktop-license-signing-key.json",
      "!backend/data/desktop-license-registry.json",
      "!frontend/pages/desktop-license-admin.html",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fanxiaolongx-max",
        "repo": "privacy-policy"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "Tools-Platform-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "frontend/assets/icon-windows.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Tools-Platform-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tools Platform"
    },
    "portable": {
      "artifactName": "Tools-Platform-Portable-${version}.${ext}",
      "requestExecutionLevel": "user",
      "splashImage": "frontend/assets/portable-splash.bmp"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "acorn": "^8.17.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "picomatch": "^4.0.4"
  }
}
